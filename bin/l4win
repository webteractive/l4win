#!/usr/bin/env php
<?php

/*
 * l4win: Laravel for Windows.
 *
 *   vendor\bin\l4win doctor            Check this machine and project
 *   vendor\bin\l4win sail up -d        Laravel Sail without bash
 *
 * Framework-free, so it works even when the Laravel app can't boot.
 */

foreach (array_filter([
    $GLOBALS['_composer_autoload_path'] ?? null,
    __DIR__.'/../vendor/autoload.php',
    __DIR__.'/../../../autoload.php',
]) as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

// Fallback so the tool still works if Composer's autoloader is broken.
spl_autoload_register(function (string $class): void {
    $prefix = 'Webteractive\\L4win\\';

    if (str_starts_with($class, $prefix) && is_file($file = __DIR__.'/../src/'.str_replace('\\', '/', substr($class, strlen($prefix))).'.php')) {
        require $file;
    }
});

use Webteractive\L4win\Cli\CliInstaller;
use Webteractive\L4win\Cli\CommandList;
use Webteractive\L4win\Doctor\Check;
use Webteractive\L4win\Doctor\Doctor;
use Webteractive\L4win\Sail\DotEnv;
use Webteractive\L4win\Sail\SailCommandBuilder;

$args = array_slice($argv, 1);
$command = array_shift($args) ?? 'list';

exit(match ($command) {
    'list' => l4win_list(),
    'doctor' => l4win_doctor(),
    'sail' => l4win_sail($args),
    'queues' => l4win_queues($args),
    'install-cli' => l4win_install_cli($args),
    'commands' => l4win_commands(),
    'help', '-h', '--help' => l4win_help($args[0] ?? null),
    default => l4win_unknown($command),
});

function l4win_list(): int
{
    echo CommandList::render(CommandList::findCli());

    return 0;
}

/**
 * Machine-readable list for l4win.exe, which merges it into its own.
 */
function l4win_commands(): int
{
    echo CommandList::machineReadable();

    return 0;
}

function l4win_unknown(string $command): int
{
    fwrite(STDERR, "Unknown command [{$command}].".PHP_EOL.PHP_EOL);
    echo CommandList::render(CommandList::findCli());

    return 1;
}

function l4win_help(?string $topic): int
{
    switch ($topic) {
        case null:
            return l4win_list();
        case 'sail':
            return l4win_sail_help(0);
        case 'doctor':
            echo "l4win doctor\n\nChecks PHP, php.ini, extensions, memory_limit, composer/node/npm/git, Git long\npaths and line endings, .env and APP_KEY, writable folders, OneDrive locations,\nold Pail versions, Octane's server, Horizon, pcntl-only packages, and CRLF\nscripts in Sail's Docker files. Works even when the app can't boot.\n";

            return 0;
        case 'queues':
            echo "l4win queues [options]\n\nRuns the supervisors in config/horizon.php with Laravel's own workers, since\nHorizon itself needs pcntl. Same as `php artisan l4win:queues`; for its\noptions run `php artisan l4win:queues --help`.\n";

            return 0;
        case 'install-cli':
            echo "l4win install-cli [--no-setup]\n\nDownloads l4win.exe from https://github.com/".CliInstaller::REPOSITORY."/releases\n(checked against its published SHA-256) into %LOCALAPPDATA%\\l4win\\bin, then runs\n`l4win setup`: PHP, Composer and Node.js, with `l4win`, php, composer, node,\nnpm and npx on your PATH. --no-setup only downloads it.\n";

            return 0;
        default:
            return l4win_unknown($topic);
    }
}

/**
 * `php artisan l4win:queues`, run from the project folder.
 *
 * @param  list<string>  $args
 */
function l4win_queues(array $args): int
{
    if (! is_file('artisan')) {
        fwrite(STDERR, "Run this from the Laravel project folder (where artisan is).\n");

        return 1;
    }

    return l4win_run(array_merge([PHP_BINARY, 'artisan', 'l4win:queues'], $args), getenv());
}

/**
 * @param  list<string>  $args
 */
function l4win_install_cli(array $args): int
{
    if (PHP_OS_FAMILY !== 'Windows') {
        fwrite(STDERR, "l4win.exe is for Windows; on ".PHP_OS_FAMILY." there's nothing to install.\n");

        return 1;
    }

    try {
        echo "Downloading l4win.exe...\n";
        [$version, $path] = (new CliInstaller)->install(CliInstaller::target());
    } catch (RuntimeException $e) {
        fwrite(STDERR, $e->getMessage().PHP_EOL);

        return 1;
    }

    echo "Installed l4win {$version} at {$path}\n";

    if (in_array('--no-setup', $args, true)) {
        echo "Run `{$path} setup` to install PHP, Composer and Node.js and put l4win on your PATH.\n";

        return 0;
    }

    echo "Running l4win setup...\n\n";

    return l4win_run([$path, 'setup'], getenv());
}

function l4win_sail_help(int $exitCode): int
{
    echo <<<'HELP'
l4win sail COMMAND [args]: Laravel Sail without bash (needs Docker Desktop)

Sail commands are the same as vendor/bin/sail: up, up -d, stop, down, ps,
build, artisan, php, composer, test, pest, pint, tinker, node, npm, npx, yarn,
bun, mysql, mariadb, psql, redis, valkey, mongodb, shell, root-shell, debug,
dusk, bin, run, share, open. Unknown commands go to docker compose.

HELP;

    return $exitCode;
}

function l4win_doctor(): int
{
    $checks = (new Doctor(getcwd() ?: null))->run();
    $failures = 0;

    echo PHP_EOL;

    foreach ($checks as $check) {
        printf("  %s %-24s %s\n", $check->symbol(), $check->label, $check->value);

        if ($check->hint !== null) {
            printf("      -> %s\n", $check->hint);
        }

        $failures += $check->status === Check::FAIL ? 1 : 0;
    }

    echo PHP_EOL.($failures > 0 ? "{$failures} problem(s) found." : 'No blocking problems.').PHP_EOL;

    return $failures > 0 ? 1 : 0;
}

/**
 * @param  list<string>  $args
 */
function l4win_sail(array $args): int
{
    if ($args === [] || in_array($args[0], ['help', '-h', '-help', '--help'], true)) {
        return l4win_sail_help($args === [] ? 1 : 0);
    }

    // Resolve the environment the way Sail does: process env, then .env (or .env.$APP_ENV), then defaults.
    $processEnv = array_map('strval', getenv());
    $envFile = (($processEnv['APP_ENV'] ?? '') !== '' && is_file('.env.'.$processEnv['APP_ENV']))
        ? '.env.'.$processEnv['APP_ENV']
        : '.env';
    $dotEnv = is_file($envFile) ? DotEnv::parse((string) file_get_contents($envFile), $processEnv) : [];
    $env = SailCommandBuilder::resolveEnvironment($processEnv, $dotEnv);

    $docker = $env['SAIL_DOCKER_BINARY'];
    [$composeV2] = l4win_capture([$docker, 'compose', 'version'], $env);
    $compose = $composeV2 === 0 ? [$docker, 'compose'] : [$docker.'-compose'];

    foreach (SailCommandBuilder::composeFiles($env['SAIL_FILES'], PHP_OS_FAMILY === 'Windows') as $file) {
        if (! is_file($file)) {
            fwrite(STDERR, "Unable to find Docker Compose file: '{$file}'\n");

            return 1;
        }

        array_push($compose, '-f', $file);
    }

    $running = true;

    if (($env['SAIL_SKIP_CHECKS'] ?? '') === '') {
        [$info] = l4win_capture([$docker, 'info'], $env);

        if ($info !== 0) {
            fwrite(STDERR, "Docker is not running. Start Docker Desktop and try again.\n");

            return 1;
        }

        [, $status] = l4win_capture(array_merge($compose, ['ps', $env['APP_SERVICE']]), $env);

        if (preg_match('/Exit|exited/', $status)) {
            fwrite(STDERR, "Shutting down old Sail processes...\n");
            l4win_capture(array_merge($compose, ['down']), $env);
            $running = false;
        } else {
            [, $ids] = l4win_capture(array_merge($compose, ['ps', '-q']), $env);
            $running = trim($ids) !== '';
        }
    }

    if (! $running && SailCommandBuilder::requiresRunningContainers($args[0])) {
        fwrite(STDERR, "Sail is not running.\n\nStart it with: 'vendor\\bin\\l4win sail up' or 'vendor\\bin\\l4win sail up -d'\n");

        return 1;
    }

    $plan = (new SailCommandBuilder($env, $compose, stream_isatty(STDIN)))->build($args);

    if ($plan['type'] === 'open') {
        return l4win_run(match (PHP_OS_FAMILY) {
            'Windows' => ['cmd', '/c', 'start', '', $plan['url']],
            'Darwin' => ['open', $plan['url']],
            default => ['xdg-open', $plan['url']],
        }, $env);
    }

    return l4win_run($plan['command'], $env);
}

/**
 * Run a command with the terminal attached, return its exit code.
 */
function l4win_run(array $command, array $env): int
{
    $process = proc_open($command, [0 => STDIN, 1 => STDOUT, 2 => STDERR], $pipes, null, $env);

    return is_resource($process) ? proc_close($process) : 1;
}

/**
 * Run a command quietly, return [exit code, stdout].
 */
function l4win_capture(array $command, array $env): array
{
    $process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, null, $env);

    if (! is_resource($process)) {
        return [1, ''];
    }

    $out = stream_get_contents($pipes[1]);
    stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);

    return [proc_close($process), (string) $out];
}
